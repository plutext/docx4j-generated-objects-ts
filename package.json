{
  "name": "@docx4j/generated-objects-ts",
  "version": "0.1.0",
  "description": "Office Open XML (WordprocessingML, DrawingML, PresentationML, SpreadsheetML, VML, ...) as typed JavaScript: Jsonix mappings and TypeScript declarations generated from docx4j's schemas, with a docx4j-style facade.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./helpers/wml": {
      "types": "./dist/helpers/wml.d.mts",
      "import": "./dist/helpers/wml.mjs"
    },
    "./builders/wml": {
      "types": "./dist/builders/wml.d.mts",
      "import": "./dist/builders/wml.mjs"
    },
    "./modules/*": {
      "types": "./modules/*.d.ts",
      "import": "./modules/*.mjs",
      "require": "./modules/*.js"
    },
    "./factory/*": {
      "types": "./modules/*.factory.d.mts",
      "import": "./modules/*.factory.mjs"
    },
    "./el/*": {
      "types": "./modules/*.el.d.mts",
      "import": "./modules/*.el.mjs"
    }
  },
  "files": [
    "dist",
    "modules",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p test/nodenext/tsconfig.json && node test/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "docx4j",
    "ooxml",
    "office open xml",
    "wordprocessingml",
    "drawingml",
    "presentationml",
    "spreadsheetml",
    "jsonix",
    "xml",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plutext/docx4j-generated-objects-ts.git"
  },
  "homepage": "https://github.com/plutext/docx4j-generated-objects-ts",
  "bugs": {
    "url": "https://github.com/plutext/docx4j-generated-objects-ts/issues"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@docx4j/jsonix": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
