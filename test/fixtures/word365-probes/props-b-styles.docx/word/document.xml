<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body><w:p><w:r><w:t xml:space="preserve">w:b against styles: ParaBold and CharBold are bold styles</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S1 CharBold, nothing direct (bold, the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBold"/></w:rPr><w:t xml:space="preserve">S1_CHARBOLD</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S2 CharBold, direct w:val="false": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBold"/><w:b w:val="false"/></w:rPr><w:t xml:space="preserve">S2_CHARBOLD_FALSE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S3 CharBold, direct w:val="off": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBold"/><w:b w:val="off"/></w:rPr><w:t xml:space="preserve">S3_CHARBOLD_OFF</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S4 CharBold, direct w:val="0": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBold"/><w:b w:val="0"/></w:rPr><w:t xml:space="preserve">S4_CHARBOLD_ZERO</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ParaBold"/></w:pPr><w:r><w:t xml:space="preserve">S5 ParaBold, nothing on the run (bold, the control): </w:t></w:r><w:r><w:t xml:space="preserve">S5_PARABOLD</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ParaBold"/></w:pPr><w:r><w:t xml:space="preserve">S6 ParaBold, direct w:val="false": </w:t></w:r><w:r><w:rPr><w:b w:val="false"/></w:rPr><w:t xml:space="preserve">S6_PARABOLD_FALSE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ParaBold"/></w:pPr><w:r><w:t xml:space="preserve">S7 ParaBold, run in CharBold (the toggle: two bold styles): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBold"/></w:rPr><w:t xml:space="preserve">S7_TOGGLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ParaBold"/></w:pPr><w:r><w:t xml:space="preserve">S8 ParaBold, run in CharBold, direct &lt;w:b/&gt;: </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBold"/><w:b/></w:rPr><w:t xml:space="preserve">S8_TOGGLE_DIRECT_BOLD</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S9 CharUnderline, nothing direct (underlined, the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderline"/></w:rPr><w:t xml:space="preserve">S9_CHARUNDERLINE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S10 CharUnderline, direct w:u w:val="none": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderline"/><w:u w:val="none"/></w:rPr><w:t xml:space="preserve">S10_CHARUNDERLINE_NONE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S11 CharUnderline, direct &lt;w:u/&gt;: </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderline"/><w:u/></w:rPr><w:t xml:space="preserve">S11_CHARUNDERLINE_BARE_U</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/></w:sectPr></w:body></w:document>