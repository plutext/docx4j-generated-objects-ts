        <w:p>
            <w:r>
                <w:t xml:space="preserve">a fill, border colour and underline colour over character styles that make them red: shading (S), border (B), underline (U)</w:t>
            </w:r>
        </w:p>
        <w:p>
            <w:r>
                <w:t xml:space="preserve">S1 CharShadingRed alone (the control): </w:t>
            </w:r>
            <w:r>
                <w:rPr>
                    <w:rStyle w:val="CharShadingRed"/>
                </w:rPr>
                <w:t xml:space="preserve">S1_STYLE</w:t>
            </w:r>
            <w:r>
                <w:t xml:space="preserve"> (end)</w:t>
            </w:r>
        </w:p>
        <w:p>
            <w:r>
                <w:t xml:space="preserve">S2 direct w:shd w:fill="F00": </w:t>
            </w:r>
            <w:r>
                <w:rPr>
                    <w:rStyle w:val="CharShadingRed"/>
                    <w:shd w:val="clear" w:color="auto" w:fill="auto"/>
                </w:rPr>
                <w:t xml:space="preserve">S2_FILL_F00</w:t>
            </w:r>
            <w:r>
