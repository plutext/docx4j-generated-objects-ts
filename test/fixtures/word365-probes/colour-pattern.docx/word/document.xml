<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body><w:p><w:r><w:t xml:space="preserve">a shading pattern's colour (w:shd w:val="pct50" w:color=..., w:fill="FFFFFF"): P1 to P5 direct, P6 to P8 over the character style CharPatternRed (a red 50% pattern)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P1 w:color="red": </w:t></w:r><w:r><w:rPr><w:shd w:val="pct50" w:color="red" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">P1_PATTERN_RED</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P2 w:color="Navy": </w:t></w:r><w:r><w:rPr><w:shd w:val="pct50" w:color="Navy" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">P2_PATTERN_NAVY</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P3 w:color="F00": </w:t></w:r><w:r><w:rPr><w:shd w:val="pct50" w:color="F00" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">P3_PATTERN_F00</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P4 w:color="FF0000" (the control): </w:t></w:r><w:r><w:rPr><w:shd w:val="pct50" w:color="FF0000" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">P4_PATTERN_HEX</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P5 w:color="auto" (the control): </w:t></w:r><w:r><w:rPr><w:shd w:val="pct50" w:color="auto" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">P5_PATTERN_AUTO</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P6 CharPatternRed alone (the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharPatternRed"/></w:rPr><w:t xml:space="preserve">P6_STYLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P7 CharPatternRed with direct w:color="F00": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharPatternRed"/><w:shd w:val="pct50" w:color="F00" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">P7_STYLE_F00</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">P8 CharPatternRed with direct w:color="Navy": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharPatternRed"/><w:shd w:val="pct50" w:color="Navy" w:fill="FFFFFF"/></w:rPr><w:t xml:space="preserve">P8_STYLE_NAVY</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p></w:body></w:document>