<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body><w:p><w:r><w:t xml:space="preserve">a fill, border colour and underline colour over character styles that make them red: shading (S), border (B), underline (U)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S1 CharShadingRed alone (the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharShadingRed"/></w:rPr><w:t xml:space="preserve">S1_STYLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S2 direct w:shd w:fill="F00": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharShadingRed"/><w:shd w:val="clear" w:color="auto" w:fill="F00"/></w:rPr><w:t xml:space="preserve">S2_FILL_F00</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S3 direct w:shd w:fill="bogus": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharShadingRed"/><w:shd w:val="clear" w:color="auto" w:fill="bogus"/></w:rPr><w:t xml:space="preserve">S3_FILL_BOGUS</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S4 direct w:shd w:fill="Aqua" (a name): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharShadingRed"/><w:shd w:val="clear" w:color="auto" w:fill="Aqua"/></w:rPr><w:t xml:space="preserve">S4_FILL_AQUA</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S5 direct w:shd w:fill="auto": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharShadingRed"/><w:shd w:val="clear" w:color="auto" w:fill="auto"/></w:rPr><w:t xml:space="preserve">S5_FILL_AUTO</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">S6 direct w:shd w:fill="00FFFF" (aqua, the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharShadingRed"/><w:shd w:val="clear" w:color="auto" w:fill="00FFFF"/></w:rPr><w:t xml:space="preserve">S6_FILL_HEX</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">B1 CharBorderRed alone (the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBorderRed"/></w:rPr><w:t xml:space="preserve">B1_STYLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">B2 direct w:bdr w:color="F00": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBorderRed"/><w:bdr w:val="single" w:sz="12" w:space="0" w:color="F00"/></w:rPr><w:t xml:space="preserve">B2_BORDER_F00</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">B3 direct w:bdr w:color="Navy" (a name): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBorderRed"/><w:bdr w:val="single" w:sz="12" w:space="0" w:color="Navy"/></w:rPr><w:t xml:space="preserve">B3_BORDER_NAVY</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">B4 direct w:bdr w:color="000080" (navy, the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBorderRed"/><w:bdr w:val="single" w:sz="12" w:space="0" w:color="000080"/></w:rPr><w:t xml:space="preserve">B4_BORDER_HEX</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">U1 CharUnderlineRed alone (the control): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderlineRed"/></w:rPr><w:t xml:space="preserve">U1_STYLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">U2 direct w:u w:val="single" w:color="F00": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderlineRed"/><w:u w:val="single" w:color="F00"/></w:rPr><w:t xml:space="preserve">U2_UNDERLINE_F00</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">U3 direct w:u w:val="single" w:color="Navy" (a name): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderlineRed"/><w:u w:val="single" w:color="Navy"/></w:rPr><w:t xml:space="preserve">U3_UNDERLINE_NAVY</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">U4 direct w:u w:val="single" w:color="auto": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderlineRed"/><w:u w:val="single" w:color="auto"/></w:rPr><w:t xml:space="preserve">U4_UNDERLINE_AUTO</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">U5 direct w:u w:val="double" (no w:color): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharUnderlineRed"/><w:u w:val="double"/></w:rPr><w:t xml:space="preserve">U5_UNDERLINE_DOUBLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p></w:body></w:document>