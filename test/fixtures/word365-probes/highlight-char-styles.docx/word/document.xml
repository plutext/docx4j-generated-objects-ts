<?xml version="1.0" encoding="UTF-8" standalone="yes"?><w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:body><w:p><w:r><w:t xml:space="preserve">highlight from a character style, in a file with nothing for Word to repair</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">H1 CharHighlight (yellow highlight) alone: </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharHighlight"/></w:rPr><w:t xml:space="preserve">H1_CHAR_STYLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">H2 CharHighlightBold (bold and yellow highlight) alone: </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharHighlightBold"/></w:rPr><w:t xml:space="preserve">H2_CHAR_STYLE_BOLD</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">H3 CharBasedOnHighlight (italic, based on CharHighlight): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharBasedOnHighlight"/></w:rPr><w:t xml:space="preserve">H3_CHAR_BASED_ON</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">H4 CharShading (yellow shading, for comparison): </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharShading"/></w:rPr><w:t xml:space="preserve">H4_CHAR_SHADING</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ParaHighlight"/></w:pPr><w:r><w:t xml:space="preserve">H5 ParaHighlight paragraph style (yellow highlight): </w:t></w:r><w:r><w:t xml:space="preserve">H5_PARA_STYLE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">H6 direct w:highlight w:val="yellow" (the control): </w:t></w:r><w:r><w:rPr><w:highlight w:val="yellow"/></w:rPr><w:t xml:space="preserve">H6_DIRECT</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">H7 CharHighlight with direct w:val="green": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharHighlight"/><w:highlight w:val="green"/></w:rPr><w:t xml:space="preserve">H7_CHAR_STYLE_DIRECT_GREEN</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:r><w:t xml:space="preserve">H8 CharHighlight with direct w:val="none": </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharHighlight"/><w:highlight w:val="none"/></w:rPr><w:t xml:space="preserve">H8_CHAR_STYLE_DIRECT_NONE</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ParaHighlight"/></w:pPr><w:r><w:t xml:space="preserve">H9 ParaHighlight paragraph and CharHighlight on the run: </w:t></w:r><w:r><w:rPr><w:rStyle w:val="CharHighlight"/></w:rPr><w:t xml:space="preserve">H9_PARA_AND_CHAR</w:t></w:r><w:r><w:t xml:space="preserve"> (end)</w:t></w:r></w:p></w:body></w:document>