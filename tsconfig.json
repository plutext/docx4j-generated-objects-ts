{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2019",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2019",
      "dom"
    ],
    "types": [],
    "skipLibCheck": false
  },
  "include": [
    "modules/*.d.ts",
    "modules/*.d.mts",
    "src/**/*.mts",
    "test/*.ts"
  ]
}
